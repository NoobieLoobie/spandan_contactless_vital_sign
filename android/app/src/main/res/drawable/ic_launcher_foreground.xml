<?xml version="1.0" encoding="utf-8"?>
<!-- [Segment 36 release] Distinct launcher icon for this side-by-side
     "Spandan Anatomy" build, so it never gets confused with (or overwrites)
     com.spandan.app already installed on the device. A white ECG/pulse
     waveform + a small filled "detection point" dot, on the adaptive-icon
     108dp canvas with content kept inside the ~66dp safe zone. No prior
     launcher icon existed for the main app (android/README.md's own
     AndroidManifest.xml comment: "No android:icon set on purpose"), so
     this is not a re-theme of an existing logo, just a new distinguishing
     mark for this build specifically. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:name="pulse_line"
        android:pathData="M21,58 L36,58 L42,40 L50,76 L58,30 L64,58 L87,58"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:name="detection_dot"
        android:pathData="M79,50 m-6,0 a6,6 0 1,1 12,0 a6,6 0 1,1 -12,0"
        android:fillColor="#FFFFFF" />
</vector>
